@using EntityLayer.Concrete
@model List<Portfolio>

<div class="section px-2 px-lg-4 pt-5" id="portfolio">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="marker marker-center">Projelerim </h2>
        </div>
        <div class="grid bp-gallery pb-3" data-aos="zoom-in-up" data-aos-delay="100">
            <div class="grid-sizer"></div>
            <div class="grid-item">
                @foreach(var item in Model)
                {
                    <a href="@item.PortfolioURl2">
                        <figure class="portfolio-item">
                            <img src="@item.PortfolioImageURl" data-bp="@item.PortfolioURl1" />
                            <figcaption>
                                <h4 class="h5 mb-0">@item.PortfolioName</h4>
                                <div>@item.PortfolioURl2</div>
                            </figcaption>
                        </figure>
                    </a>
                }
            </div>
        </div>
    </div>
</div>